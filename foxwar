_FHS_LI = re.compile(
    r"data-iconType='(\d+)'[^>]*title='\[(\d+)\]'>.*?<img\b[^>]*>\s*"
    r"([^<]+?)\s*</span>.*?class='time'>(\d+)</span>", re.S)
_FHS_TXT = re.compile(
    r"^(.*?)\s+-\s+(.*?) was ([A-Za-z0-9 ]+?) by (Colonials|Wardens)\b", re.S)
_FHS_KIND = {"Taken": "capture", "Under": "build", "Lost": "lost",
             "Upgraded": "upgrade"}
BASE_EVENT_ICONS = {8, 27, 45, 56, 57, 58}


def fhs_events():
    """The foxholestats Live Event Log, oldest first. Cached FHS_TTL secs;
    on failure falls back to the cache, then []."""
    cached = None
    try:
        with open(FHS_CACHE) as f:
            cached = json.load(f)
        if time.time() - cached["ts"] < FHS_TTL:
            return cached["events"]
    except (OSError, ValueError, KeyError):
        pass
    try:
        req = urllib.request.Request(FHS_URL, headers={
            "User-Agent": "foxwar-cli", "Accept-Encoding": "gzip"})
        with urllib.request.urlopen(req, timeout=20) as r:
            raw = r.read()
            if r.headers.get("Content-Encoding") == "gzip":
                raw = gzip.decompress(raw)
        html = raw.decode("utf-8", "replace")
    except Exception:
        return cached["events"] if cached else []

    evs = []
    for icon, eid, body, ts in _FHS_LI.findall(html):
        m = _FHS_TXT.match(body)
        if not m:
            continue
        region, struct, verb, team = m.groups()
        evs.append({
            "id": int(eid), "ts": int(ts), "icon": int(icon),
            "to": "COLONIALS" if team == "Colonials" else "WARDENS",
            "region": region.strip(), "struct": struct.strip(),
            "kind": _FHS_KIND.get(verb.strip().split()[0], "other"),
        })
    evs.sort(key=lambda e: e["id"])
    evs = evs[-400:]
    try:
        os.makedirs(CACHE, exist_ok=True)
        with open(FHS_CACHE, "w") as f:
            json.dump({"ts": time.time(), "events": evs}, f)
    except OSError:
        pass
    return evs


_AXIAL_DIRS = [(-1, 0), (-1, 1), (0, 1), (1, 0), (1, -1), (0, -1)]
_QP = {n: (q, p) for n, (q, p, _) in HEXES.items()}
_BY_QP = {v: k for k, v in _QP.items()}


def _neighbours(name):
    q, p = _QP[name]
    return [_BY_QP[(q + dq, p + dp)] for dq, dp in _AXIAL_DIRS
            if (q + dq, p + dp) in _BY_QP]


def current_invasions(hexes):
    """Region -> {'reason': 'capture'|'battle', 'rate': deaths/min or None}.

    'battle' hexes come from track() (front line + elevated casualty rate);
    'capture' hexes had a base captured/started (per foxholestats) within
    INVASION_WINDOW in a region the gaining faction doesn't control. Once both
    factions hold a base the hex is 'contested' instead - see asciimap.
    """
    now = time.time()
    hot = {}
    for name, v in (_load_state().get("hot") or {}).items():
        if isinstance(v, list) and len(v) >= 2 and v[0] > now:
            hot[name] = v[1]

    inv = {name: {"reason": "battle", "rate": r} for name, r in hot.items()
           if hexes.get(name, {}).get("ctrl") != "contested"}
    for e in fhs_events():
        if (now - e["ts"] >= INVASION_WINDOW or e["kind"] not in ("capture", "build")
                or e["icon"] not in BASE_EVENT_ICONS):
            continue
        name = FHS_REGION.get(e["region"])
        ctrl = hexes.get(name, {}).get("ctrl")
        gain = "colonial" if e["to"] == "COLONIALS" else "warden"
        # a breakthrough into a hex the enemy still holds outright - not a
        # retake, and not just more back-and-forth in an already-contested hex
        if name and ctrl not in (gain, "contested"):
            inv.setdefault(name, {"rate": hot.get(name)})["reason"] = "capture"
    return inv


