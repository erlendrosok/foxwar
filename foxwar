def api(path):
    """GET with on-disk ETag revalidation."""
    os.makedirs(CACHE, exist_ok=True)
    key = os.path.join(CACHE, path.strip("/").replace("/", "_") + f".s{SHARD}.json")
    etag, cached = None, None
    if os.path.exists(key):
        try:
            with open(key) as f:
                cached = json.load(f)
            etag = cached.get("__etag")
        except (OSError, ValueError):
            cached = None
    req = urllib.request.Request(ROOT + path, headers={"User-Agent": "foxwar-cli"})
    if etag:
        req.add_header("If-None-Match", etag)
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            data = json.load(r)
            data["__etag"] = r.headers.get("ETag")
            with open(key, "w") as f:
                json.dump(data, f)
            return data
    except urllib.error.HTTPError as e:
        if e.code == 304 and cached is not None:
            return cached
        raise


# keep, relic base, town base t1-3 - the capturable bases that mark a foothold
BASE_ICONS = (27, 45, 56, 57, 58)


def hex_data(name):
    try:
        d = api(f"/worldconquest/maps/{name}/dynamic/public")
    except Exception:
        d = {"mapItems": [], "version": None, "lastUpdated": 0}
    try:
        rep = api(f"/worldconquest/warReport/{name}")
    except Exception:
        rep = {}

    held = {"COLONIALS": 0, "WARDENS": 0}
    vt = {"COLONIALS": 0, "WARDENS": 0}
    for m in d.get("mapItems", []):
        it, t, fl = m["iconType"], m["teamId"], m.get("flags", 0)
        if it not in BASE_ICONS or fl & 0x04:   # skip build sites
            continue
        if t in held:
            held[t] += 1
        if fl & 0x01 and not fl & 0x10 and t in vt:   # victory base, not scorched
            vt[t] += 1

    c_, w_ = held["COLONIALS"], held["WARDENS"]
    if c_ and w_:               # both factions hold a base -> a foothold each
        ctrl = "contested"
    elif c_ or w_:
        ctrl = "colonial" if c_ > w_ else "warden"
    else:
        ctrl = "neutral"

    return {
        "ctrl": ctrl, "vt": vt,
        "col_cas": rep.get("colonialCasualties", 0),
        "war_cas": rep.get("wardenCasualties", 0),
        "enlist": rep.get("totalEnlistments", 0),
        "day": rep.get("dayOfWar", 0),
    }


def fetch_all():
    war = api("/worldconquest/war")
    out = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        for name, d in zip(HEXES, ex.map(hex_data, HEXES)):
            out[name] = d
    return war, out


# ---- casualty / hot-region tracking --------------------------------
STATE = os.path.join(CACHE, f"state.s{SHARD}.json")
STATE_FMT = 5


def _load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def _save_state(obj):
    tmp = STATE + f".{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, STATE)


def track(war, hexes):
    """Refresh the rolling per-region casualty rate and the 'hot' front-line
    set in state.s{N}.json. Every foxwar process writes this one file; a newer
    on-disk format means a newer foxwar is running too, so bail rather than
    clobber it."""
    st = _load_state()
    if st.get("fmt", 0) > STATE_FMT:
        return
    fresh = st.get("war") != war["warNumber"] or st.get("fmt") != STATE_FMT
    prev_cas = {} if fresh else st.get("cas", {})
    prev_hot = {} if fresh else (st.get("hot") or {})
    now = time.time()
    cas, hot, rate = {}, {}, {}
    for name, h in hexes.items():
        # casualties only ever climb; a drop means a bad fetch - skip it
        hist = [] if fresh else list(prev_cas.get(name, []))
        deaths = h["col_cas"] + h["war_cas"]
        if not hist or deaths >= hist[-1][1] + hist[-1][2]:
            hist.append([now, h["col_cas"], h["war_cas"]])
        hist = [pt for pt in hist if now - pt[0] <= RATE_KEEP]
        cas[name] = hist
        ref = next((pt for pt in hist if now - pt[0] <= RATE_WINDOW), hist[0])
        span = now - ref[0]
        if span >= RATE_MIN and deaths >= ref[1] + ref[2]:
            rate[name] = (deaths - ref[1] - ref[2]) / (span / 60)

    active = sorted(r for r in rate.values() if r > 1)
    median = active[len(active) // 2] if active else 0.0
    for name, r in rate.items():
        h = hexes[name]
        frontline = h["ctrl"] in ("colonial", "warden") and any(
            hexes[n]["ctrl"] == ("warden" if h["ctrl"] == "colonial" else "colonial")
            for n in _neighbours(name))
        elevated = r >= HOT_FLOOR and (r >= HOT_RATE or r >= REL_MULT * median)
        until = (prev_hot.get(name) or [0])[0]
        if frontline and elevated:
            until = now + HOT_COOLDOWN
        if until > now:
            hot[name] = [until, r]

    _save_state({"fmt": STATE_FMT, "war": war["warNumber"], "ts": now,
                 "cas": cas, "hot": hot})


