def player_count():
    """Steam concurrent players for Foxhole (global, not per-shard). Cached 3 min."""
    try:
        with open(PLAYERS_CACHE) as f:
            o = json.load(f)
        if time.time() - o["ts"] < 180:
            return o["n"]
    except (OSError, ValueError, KeyError):
        o = None
    try:
        req = urllib.request.Request(STEAM_URL, headers={"User-Agent": "foxwar-cli"})
        with urllib.request.urlopen(req, timeout=10) as r:
            n = int(json.load(r)["response"]["player_count"])
        os.makedirs(CACHE, exist_ok=True)
        with open(PLAYERS_CACHE, "w") as f:
            json.dump({"ts": time.time(), "n": n}, f)
        return n
    except Exception:
        return o["n"] if o else None


