# ---- rendering -------------------------------------------------------
def totals(war, hexes):
    col = sum(h["col_cas"] for h in hexes.values())
    wr = sum(h["war_cas"] for h in hexes.values())
    enl = sum(h["enlist"] for h in hexes.values())
    day = max((h["day"] for h in hexes.values()), default=0)
    cvt = sum(h["vt"]["COLONIALS"] for h in hexes.values())
    wvt = sum(h["vt"]["WARDENS"] for h in hexes.values())
    return col, wr, enl, day, cvt, wvt


def region_rates():
    """{region: (colonial/min, warden/min)} over RATE_WINDOW. Empty until the
    casualty history is deep enough. Format-tolerant: reads whatever `cas`
    entries look like [ts, colonial, warden], regardless of state fmt, so a
    still-running older foxwar keeps showing rates the poll service writes."""
    now = time.time()
    out = {}
    for name, hist in (_load_state().get("cas") or {}).items():
        pts = [p for p in hist if isinstance(p, list) and len(p) >= 3]
        if len(pts) < 2:
            continue
        cur = pts[-1]
        ref = next((p for p in pts if now - p[0] <= RATE_WINDOW), pts[0])
        span = cur[0] - ref[0]
        if span >= RATE_MIN:
            mins = span / 60
            out[name] = (max(0.0, cur[1] - ref[1]) / mins,
                         max(0.0, cur[2] - ref[2]) / mins)
    return out


def casualty_rates():
    """Map-wide (colonial/min, warden/min), or None if not enough history."""
    rr = region_rates()
    if not rr:
        return None
    return (sum(c for c, _ in rr.values()), sum(w for _, w in rr.values()))


def _cas_ages():
    now = time.time()
    return [now - h[0][0] for h in (_load_state().get("cas") or {}).values()
            if h and isinstance(h[0], list) and len(h[0]) >= 3]


def rate_span_min():
    """Effective averaging window: grows with history, capped at RATE_WINDOW."""
    ages = _cas_ages()
    return min(RATE_WINDOW, max(ages)) / 60 if ages else 0.0


def rate_status():
    """None once casualty rates are live, else a short 'warming up' note."""
    if region_rates():
        return None
    ages = _cas_ages()
    have = (max(ages) / 60) if ages else 0.0
    poll = "" if ages else " - start `foxwar poll` or keep this open"
    return f"casualty rates warming up ({have:.0f} of {RATE_MIN / 60:.0f} min){poll}"


def bar(frac, width=32):
    n = round(frac * width)
    return COL("█" * n) + WAR("█" * (width - n))


def _invasion_line(invasions):
    if not invasions:
        return NEU("No invasion alerts.")
    parts = []
    for r in sorted(invasions, key=lambda r: HEXES[r][2].lower()):
        info = invasions[r]
        rate, reason = info.get("rate"), info.get("reason")
        if reason == "capture":
            tag = " capture"
        elif rate:
            tag = f" {rate:.0f}/min"
        else:
            tag = ""
        parts.append(CON(HEXES[r][2]) + NEU(tag))
    return ALERT(f" ‼ INVASION ALERT ({len(invasions)}) ") + "  " + "  ".join(parts)


def summary(war, hexes, invasions, players=None):
    col, wr, enl, day, cvt, wvt = totals(war, hexes)
    tot = col + wr or 1
    need = war["requiredVictoryTowns"]
    winner = war["winner"]
    rates = casualty_rates()
    cr = (f"  {COL(f'+{rates[0] * 60:,.0f}/hr')}",
          f"  {WAR(f'+{rates[1] * 60:,.0f}/hr')}") if rates else ("", "")
    L = [BOLD(f"War #{war['warNumber']}   Day {day}")
         + (f"   {c('WINNER: ' + winner, '1;33')}" if winner != "NONE" else ""),
         "",
         f"Victory towns   {COL(str(cvt))} Colonial   {WAR(str(wvt))} Warden"
         f"   (need {need} to win)",
         "  " + bar(cvt / max(cvt + wvt, 1)),
         "",
         f"Casualties      {COL(f'{col:>10,}')}  {col / tot:5.1%} Colonial{cr[0]}",
         f"                {WAR(f'{wr:>10,}')}  {wr / tot:5.1%} Warden{cr[1]}",
         "  " + bar(col / tot),
         f"Total dead      {col + wr:>10,}" + (
             f"   {NEU(f'({(rates[0] + rates[1]) * 60:,.0f}/hr, {rate_span_min():.0f}-min avg)')}"
             if rates else f"   {NEU('(' + rate_status() + ')')}"),
         f"Enlistments     {enl:>10,}"]
    if players is not None:
        L.append(f"Steam players   {players:>10,}  in-game now")
    L += ["", _invasion_line(invasions),
          "", BOLD("Recent events") + NEU("  (foxholestats.com)"), recent_block(8)]
    return "\n".join(L)


def regions(war, hexes, invasions, limit=None, by="dead"):
    rr = region_rates()
    if by == "rate" and rr:
        rows = sorted(hexes.items(), key=lambda kv: -sum(rr.get(kv[0], (0, 0))))
    else:
        rows = sorted(hexes.items(),
                      key=lambda kv: -(kv[1]["col_cas"] + kv[1]["war_cas"]))
    if limit:
        rows = rows[:limit]
    out = [BOLD(f"{'Region':<11}{'Control':<11}{'':2}"
               f"{'dead C':>10} /{'dead W':>10}   {'C/hr':>6} {'W/hr':>6}")]
    for name, h in rows:
        ctrl = h["ctrl"]
        flag = (ALERT("‼") if name in invasions
                else CON("⚔") if ctrl == "contested" else " ")
        cpm, wpm = rr.get(name, (None, None))
        cr = COL(f"{cpm * 60:>6,.0f}") if cpm else f"{('·' if cpm == 0 else ''):>6}"
        wrt = WAR(f"{wpm * 60:>6,.0f}") if wpm else f"{('·' if wpm == 0 else ''):>6}"
        out.append(f"{HEXES[name][2]:<11}{TINT[ctrl](f'{ctrl:<11}')}{flag} "
                   f"{h['col_cas']:>10,} /{h['war_cas']:>10,}   {cr} {wrt}")
    return "\n".join(out)


def _vislen(s):
    return len(re.sub(r"\033\[[0-9;]*m", "", s))


def asciimap(war, hexes, invasions):
    # Foxhole flat-top hex grid. Layout (q, p) -> screen:
    #   column = p          (west -> east)
    #   line   = 2q + p     (north -> south; +/-1 per column so columns interleave)
    import shutil
    cells = {(p, 2 * q + p): name for name, (q, p, _) in HEXES.items()}
    cmin, cmax = min(c for c, _ in cells), max(c for c, _ in cells)
    lmin, lmax = min(l for _, l in cells), max(l for _, l in cells)

    ncols = cmax - cmin + 1
    termw = shutil.get_terminal_size((110, 24)).columns
    cw = max(5, min(11, termw // ncols))
    lw = cw - 1
    wide = cw >= 10

    rows = []
    for ln in range(lmin, lmax + 1):
        line = ""
        for cp in range(cmin, cmax + 1):
            if (cp, ln) not in cells:
                continue
            name = cells[(cp, ln)]
            h = hexes[name]
            if name in invasions:
                cell = ALERT(HEXES[name][2][:lw - 1] + "‼")
            elif h["ctrl"] == "contested":
                cell = TINT["contested"](HEXES[name][2][:lw - 1] + "⚔")
            else:
                cell = TINT[h["ctrl"]](HEXES[name][2][:lw])
            line += " " * max(0, (cp - cmin) * cw - _vislen(line)) + cell
        rows.append(line.rstrip())

    legend = (f"{COL('colonial')}  {WAR('warden')}  {CON('contested ⚔')}  "
              f"{NEU('neutral')}  {ALERT(' ‼ invasion alert ')}")
    return "\n".join(rows) + "\n\n" + legend


_VERB = {"capture": "took", "build": "building", "lost": "lost",
         "upgrade": "upgraded"}


def fmt_event(e, with_date=False):
    stamp = time.strftime("%b %d %H:%M" if with_date else "%H:%M",
                          time.localtime(e["ts"]))
    tint = COL if e["to"] == "COLONIALS" else WAR
    who = "Colonials" if e["to"] == "COLONIALS" else "Wardens"
    verb = _VERB.get(e["kind"], e["kind"])
    return (f"{NEU(stamp)}  {tint(who + ' ' + verb)} {e['struct']} "
            f"{NEU('- ' + e['region'])}")


def events_view(n, indent=""):
    evs = fhs_events()
    if not evs:
        return NEU(indent + "Event log unavailable (couldn't reach foxholestats.com).")
    shown = evs[-n:]
    multiday = time.time() - shown[0]["ts"] > 86400
    return "\n".join(indent + fmt_event(e, multiday) for e in shown)


# ---- tmux segment ----------------------------------------------------
TMUX_LINE = os.path.join(CACHE, f"tmux.s{SHARD}.line")
TMUX_TTL = int(os.environ.get("FOXWAR_TMUX_TTL", "300"))


def tmux_line(war, hexes, invasions, players=None):
    col, wr, _, day, cvt, wvt = totals(war, hexes)
    tot = col + wr or 1
    lead = cvt - wvt
    arrow = "C+" if lead > 0 else ("W+" if lead < 0 else "=")
    s = f"FH{war['warNumber']} d{day}  VT {cvt}-{wvt} {arrow}{abs(lead)}  ☠ {col / tot * 100:.0f}/{wr / tot * 100:.0f}"
    if players is not None:
        s += f"  {players / 1000:.1f}k" if players >= 1000 else f"  {players}"
    if invasions:
        s += f"  ‼{len(invasions)}"
    return s


def tmux_cached():
    fresh = (os.path.exists(TMUX_LINE)
             and time.time() - os.path.getmtime(TMUX_LINE) < TMUX_TTL)
    if not fresh:
        import subprocess
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--shard", SHARD,
             "_tmux_refresh"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True)
    try:
        with open(TMUX_LINE) as f:
            return f.read().strip()
    except OSError:
        return "FH …"


def tmux_refresh():
    os.makedirs(CACHE, exist_ok=True)
    try:
        war, hexes = fetch_all()
        track(war, hexes)
        line = tmux_line(war, hexes, current_invasions(hexes), player_count())
    except Exception:
        return
    tmp = TMUX_LINE + f".{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.write(line)
    os.replace(tmp, TMUX_LINE)


# ---- main ----------------------------------------------------------
def _clear():
    sys.stdout.write("\033[H\033[2J")


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "summary"
    arg2 = sys.argv[2] if len(sys.argv) > 2 else None

    if mode == "tmux":
        print(tmux_cached())
        return
    if mode == "_tmux_refresh":
        tmux_refresh()
        return

    if mode in ("events", "ev", "log"):
        print(events_view(int(arg2) if arg2 else 30))
        return

    if mode == "poll":
        secs = int(arg2) if arg2 else 60
        print(NEU(f"foxwar poll - shard {SHARD}, casualty tracking every {secs}s. "
                  "Ctrl-C to quit."), flush=True)
        seen = set()
        try:
            while True:
                try:
                    war, hexes = fetch_all()
                    track(war, hexes)
                    for e in fhs_events():          # served from cache mostly
                        if seen and e["id"] not in seen:
                            print(fmt_event(e), flush=True)
                        seen.add(e["id"])
                except Exception as exc:
                    print(NEU(f"({exc})"), flush=True)
                time.sleep(secs)
        except KeyboardInterrupt:
            return

    if mode == "watch":
        secs = int(arg2) if arg2 else 60
        try:
            while True:
                war, hexes = fetch_all()
                track(war, hexes)
                invasions = current_invasions(hexes)
                _clear()
                print(asciimap(war, hexes, invasions))
                print()
                print(_invasion_line(invasions))
                print()
                rs = rate_status()
                print(BOLD("Most active regions")
                      + (NEU("  - " + rs) if rs else ""))
                print(regions(war, hexes, invasions, limit=6, by="rate"))
                print()
                print(BOLD("Recent events") + NEU("  (foxholestats.com)"))
                print(events_view(10))
                print()
                col, wr, _, day, cvt, wvt = totals(war, hexes)
                pc = player_count()
                rates = casualty_rates()
                dead = (f"☠ {COL(f'+{rates[0] * 60:,.0f}')}/{WAR(f'+{rates[1] * 60:,.0f}')}/hr"
                        if rates else f"☠ {col + wr:,}")
                print(f"War #{war['warNumber']}  Day {day}   "
                      f"VT {COL(str(cvt))}-{WAR(str(wvt))}/{war['requiredVictoryTowns']}"
                      f"   {dead}" + (f"   {pc:,} players" if pc else ""))
                print(NEU(f"updated {time.strftime('%H:%M:%S')} - Ctrl-C to quit"))
                sys.stdout.flush()
                time.sleep(secs)
        except KeyboardInterrupt:
            return

    if mode not in ("summary", "sum", "map", "regions", "reg", "all", "full"):
        print(__doc__)
        sys.exit(0 if mode in ("-h", "--help", "help") else 1)

    war, hexes = fetch_all()
    track(war, hexes)   # every read view also advances casualty tracking
    invasions = current_invasions(hexes)

    if mode in ("summary", "sum"):
        print(summary(war, hexes, invasions, player_count()))
    elif mode == "map":
        print(asciimap(war, hexes, invasions))
    elif mode in ("regions", "reg"):
        print(regions(war, hexes, invasions))
    elif mode in ("all", "full"):
        print(asciimap(war, hexes, invasions))
        print()
        print(summary(war, hexes, invasions, player_count()))


if __name__ == "__main__":
    main()
